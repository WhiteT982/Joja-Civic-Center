{
  "Format": "2.9.1",
  "ConfigSchema": {
    "Choose Your Bundle Base": {
      "AllowValues": "Vanilla, SVE, RSV, East Scarp, VMV, SVE+RSV+ES",
      "Default": "Vanilla",
      "Section": "Bundle Base"
    },
    "Remixed Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons"
    },
    "Random Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons"
    },
    "Enable More Difficult Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons"
    },
    "Enable Cornucopia Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons",
      "Description": "Must have Cornucopia-More Crops installed. Must also enable \"Enable Extended Crops Pack\" and \"Enable Herbs Pack\" in the Cornucopia config."
    },
    "Alternate Joja CC Location": {
      "AllowValues": "Default, North Pelican Town, Joja Mart, Museum",
      "Default": "Default",
      "Section": "Alternate Locations/Entrances",
      "Description": "If changing Joja CC locations mid save you WILL need to use a Terrain Features Reset mod to remove bushes/debris."
    },
    "Alternate Fish Farm Location": {
      "AllowValues": "Default, Alternate 1, Alternate 2",
      "Default": "Default",
      "Section": "Alternate Locations/Entrances",
      "Description": "Places Willy's Fish Farm in a new location for compatibility reasons. Avoid changing this value after the fish farm is built. It will not break your game, but there will be a few minor errors. Select Default to place fish farm in vanilla tide pool location. Select either Alternate to place fish farm in a new area to the East of the vanilla tide pools."
    },
    "Alternate Leah's Woods Entrance": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Alternate Locations/Entrances",
      "Description": "Moves Leah's Woods entrance to the left side of the Backwoods."
    }
  },
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/advancedpricing.json, Data/Bundles/bundlebooks.json, Data/MapPatches/beachalternate.json, Data/MapPatches/beach.json, Data/MapPatches/shoppatches.json, Data/MapPatches/cellar.json, Data/MapPatches/JojaCC.json, Data/MapPatches/foragermap.json, Data/MapPatches/gingerisland.json, Data/MapPatches/clintscave.json, Data/strings.json, Data/prizeticketmachine.json, Data/triggers.json, Data/mail.json, Data/minecart.json, Data/machines.json, Data/npcgifttastes.json, Data/events.json, Data/shop.json, Data/Objects/soup.json, Data/buildings.json, Data/Objects/treasurehunttag.json, Data/Objects/eventobjects.json, Data/Bundles/treasurehunt.json, assets/Maps/worldmap.json, Data/Orders/contexttags.json, Data/Orders/shop.json, Data/Orders/specialorders.json, Data/NPC/JojaSign.json, Data/NPC/JojaSigndialogue.json, Data/MapPatches/EggHunt/EggHunt.json, Data/lostandfound.json"
