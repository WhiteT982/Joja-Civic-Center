{
  "Format": "2.9.1",
  "ConfigSchema": {
    "Choose Your Bundle Base": {
      "AllowValues": "Vanilla, SVE, RSV, East Scarp, VMV, SVE+RSV+ES",
      "Default": "Vanilla",
      "Section": "Bundle Base"
    },
    "Enable More Difficult Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons"
    },
    "Enable Cornucopia Bundles": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Bundle Addons",
      "Description": "Must have Cornucopia-More Crops Extended enabled."
    },
    "Enable": {
      "AllowValues": "true, false",
      "Default": "false",
      "Section": "Alternate Fish Farm Location",
      "Description": "Places Willy's Fish Farm in a new location for compatibility reasons. Avoid changing this value after the fish farm is built. It will not break your game, but there will be a few minor errors. Select false to place fish farm in vanilla tide pool location. Select true to place fish farm in a new area to the East of the vanilla tide pools."
    }
  },
  "Changes": [
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/bundlebooks.json, Data/MapPatches/beachalternate.json, Data/MapPatches/beach.json, Data/MapPatches/shoppatches.json, Data/MapPatches/cellar.json, Data/MapPatches/JojaCC.json, Data/MapPatches/foragermap.json, Data/MapPatches/gingerisland.json, Data/MapPatches/clintscave.json, Data/strings.json, Data/schedules.json, Data/prizeticketmachine.json, Data/triggers.json, Data/mail.json, Data/minecart.json, Data/machines.json, Data/npcgifttastes.json, Data/events.json, Data/shop.json, Data/Objects/soup.json, Data/buildings.json, Data/Objects/treasurehunttag.json, Data/Objects/eventobjects.json, Data/Bundles/treasurehunt.json, assets/Maps/worldmap.json, Data/Orders/contexttags.json, Data/Orders/shop.json, Data/Orders/specialorders.json"
    },
    //Order Board Includes
    {
      "When": {
        "HasMod": "FlashShifter.StardewValleyExpandedCP"
      },
      "Action": "Include",
      "FromFile": "Data/Orders/SVE.json"
    },
    {
      "When": {
        "HasMod": "Cornucopia.MoreCrops"
      },
      "Action": "Include",
      "FromFile": "Data/Orders/Cornucopia.json"
    },
    {
      "When": {
        "HasMod": "Cornucopia.MoreCrops",
        "HasFlag": "Cornucopia.MoreCrops_ExtendedCropsPackEnabled"
      },
      "Action": "Include",
      "FromFile": "Data/Orders/CornucopiaExtended.json"
    },
    //Bundle Configs
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/Vanillabundles.json",
      "When": {
        "Choose Your Bundle Base": "Vanilla"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/RSVbundles.json",
      "When": {
        "Choose Your Bundle Base": "RSV"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/SVEbundles.json",
      "When": {
        "Choose Your Bundle Base": "SVE"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/ESbundles.json",
      "When": {
        "Choose Your Bundle Base": "East Scarp"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/VMVbundles.json",
      "When": {
        "Choose Your Bundle Base": "VMV"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/Bundles/SVE_RSV_ESbundles.json",
      "When": {
        "Choose Your Bundle Base": "SVE+RSV+ES"
      }
    },
    //Alternate Fish Farm Config
    {
      "Action": "Include",
      "FromFile": "Data/MapPatches/beach.json",
      "Update": "OnLocationChange",
      "When": {
        "Enable": "false"
      }
    },
    {
      "Action": "Include",
      "FromFile": "Data/MapPatches/beachalternate.json",
      "Update": "OnLocationChange",
      "When": {
        "Enable": "true"
      }
    },
    //TH Bundle Randomization
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:1, 7, 13, 19, A}}.json"
    },
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:2, 8, 14, 20, B}}.json"
    },
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:3, 9, 15, 21, C}}.json"
    },
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:4, 10, 16, 22, D}}.json"
    },
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:5, 11, 17, 23, E}}.json"
    },
    {
      "Action": "Include",
      "When":{
        "HasFlag": "RandomizeTHbundles",
        "HasFlag: anyPlayer|contains=TreasureHuntComplete": false
      },
      "FromFile": "Data/Bundles/TreasureHunt/{{Random:6, 12, 18, 24, F}}.json"
    }
  ]
}